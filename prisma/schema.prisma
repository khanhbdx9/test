generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LOCKED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  status        UserStatus     @default(ACTIVE)
  roleId        String         @map("role_id") @db.Uuid
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  notifications Notification[]
  posts         Post[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  tokenHash    String        @unique @map("token_hash")
  expiresAt    DateTime      @map("expires_at")
  revokedAt    DateTime?     @map("revoked_at")
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaced     RefreshToken? @relation("RefreshRotation")
  createdAt    DateTime      @default(now()) @map("created_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum CategoryStatus {
  VISIBLE
  HIDDEN
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  parentId       String?        @map("parent_id") @db.Uuid
  parent         Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]     @relation("CategoryTree")
  name           String
  slug           String         @unique
  description    String?        @db.Text
  imageUrl       String?        @map("image_url")
  status         CategoryStatus @default(VISIBLE)
  sortOrder      Int            @default(0) @map("sort_order")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description")
  products       Product[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  @@index([parentId])
  @@index([status])
  @@index([deletedAt])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  categoryId       String         @map("category_id") @db.Uuid
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sku              String         @unique
  name             String
  slug             String         @unique
  shortDescription String?        @map("short_description") @db.Text
  description      String?        @db.Text
  price            Decimal        @db.Decimal(12, 2)
  salePrice        Decimal?       @map("sale_price") @db.Decimal(12, 2)
  status           ProductStatus  @default(DRAFT)
  isFeatured       Boolean        @default(false) @map("is_featured")
  isBestSeller     Boolean        @default(false) @map("is_best_seller")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  images           ProductImage[]
  variants         ProductVariant[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([productId, isCover])
  @@map("product_images")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

model ProductVariant {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String        @unique
  size      String
  style     String
  price     Decimal       @db.Decimal(12, 2)
  salePrice Decimal?      @map("sale_price") @db.Decimal(12, 2)
  status    VariantStatus @default(ACTIVE)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

enum PaymentMethod {
  AT_STORE
  BANK_TRANSFER
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_CONFIRMATION
  REJECTED
  CONFIRMED
  NEED_CALLBACK
  COMPLETED
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  email             String?
  phone             String
  shippingAddress   String?           @map("shipping_address")
  fullName          String?           @map("full_name")
  note              String?           @db.Text
  paymentMethod     PaymentMethod     @map("payment_method")
  paymentImageUrl   String?           @map("payment_image_url")
  fulfillmentMethod FulfillmentMethod @map("fulfillment_method")
  status            OrderStatus       @default(PENDING_CONFIRMATION)
  deliveryDate      DateTime?         @map("delivery_date") @db.Date
  deliveryTime      String?           @map("delivery_time")
  totalAmount       Decimal           @map("total_amount") @db.Decimal(12, 2)
  items             OrderItem[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@index([paymentMethod])
  @@index([fulfillmentMethod])
  @@index([status])
  @@index([deliveryDate])
  @@index([deliveryTime])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  productName String   @map("product_name")
  productSku  String   @map("product_sku")
  variantSku  String   @map("variant_sku")
  size        String
  style       String
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("system_configs")
}

model Theme {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?  @db.Text
  config      Json
  previewUrl  String?  @map("preview_url")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("themes")
}

model Banner {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  desktopImageUrl String    @map("desktop_image_url")
  mobileImageUrl  String?   @map("mobile_image_url")
  link            String?
  position        String
  sortOrder       Int       @default(0) @map("sort_order")
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([position])
  @@index([isActive])
  @@index([sortOrder])
  @@map("banners")
}

enum NotificationType {
  ORDER_CREATED
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  metadata  Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  authorId       String     @map("author_id") @db.Uuid
  author         User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title          String
  slug           String     @unique
  thumbnailUrl   String?    @map("thumbnail_url")
  content        String     @db.Text
  excerpt        String?    @db.Text
  status         PostStatus @default(DRAFT)
  showOnLanding  Boolean    @default(false) @map("show_on_landing")
  publishedAt    DateTime?  @map("published_at")
  seoTitle       String?    @map("seo_title")
  seoDescription String?    @map("seo_description")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  @@index([authorId])
  @@index([status])
  @@index([deletedAt])
  @@index([publishedAt])
  @@index([showOnLanding])
  @@map("posts")
}
