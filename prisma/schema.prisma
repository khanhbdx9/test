generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LOCKED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  status        UserStatus     @default(ACTIVE)
  roleId        String         @map("role_id") @db.Uuid
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  tokenHash    String        @unique @map("token_hash")
  expiresAt    DateTime      @map("expires_at")
  revokedAt    DateTime?     @map("revoked_at")
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaced     RefreshToken? @relation("RefreshRotation")
  createdAt    DateTime      @default(now()) @map("created_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum CategoryStatus {
  VISIBLE
  HIDDEN
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  parentId       String?        @map("parent_id") @db.Uuid
  parent         Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]     @relation("CategoryTree")
  name           String
  slug           String         @unique
  description    String?        @db.Text
  imageUrl       String?        @map("image_url")
  status         CategoryStatus @default(VISIBLE)
  sortOrder      Int            @default(0) @map("sort_order")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description")
  products       Product[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  @@index([parentId])
  @@index([status])
  @@index([deletedAt])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  categoryId       String         @map("category_id") @db.Uuid
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sku              String         @unique
  name             String
  slug             String         @unique
  shortDescription String?        @map("short_description") @db.Text
  description      String?        @db.Text
  price            Decimal        @db.Decimal(12, 2)
  salePrice        Decimal?       @map("sale_price") @db.Decimal(12, 2)
  status           ProductStatus  @default(DRAFT)
  isFeatured       Boolean        @default(false) @map("is_featured")
  isBestSeller     Boolean        @default(false) @map("is_best_seller")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  images           ProductImage[]
  variants         ProductVariant[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([productId, isCover])
  @@map("product_images")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

model ProductVariant {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String        @unique
  size      String
  style     String
  price     Decimal       @db.Decimal(12, 2)
  salePrice Decimal?      @map("sale_price") @db.Decimal(12, 2)
  status    VariantStatus @default(ACTIVE)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([productId])
  @@index([status])
  @@map("product_variants")
}
